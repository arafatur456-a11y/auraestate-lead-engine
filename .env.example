# Elena, the AI concierge (/api/chat) uses the FIRST key that is set.
# With no key, the chat runs on the built-in conversation engine (no external calls).

# Anthropic (recommended)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# OpenRouter (any model it hosts)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/auto
