# Elena, the AI concierge (/api/chat) uses the FIRST key that is set.
# With no key, the chat runs on the built-in conversation engine (no external calls).

# Anthropic (recommended)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# OpenRouter — easiest low-cost option (one key, hundreds of models)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.0-flash-001     # default: fast & cheap
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ---------------------------------------------------------------
# Broker CRM access
# PIN brokers enter to open the CRM (checked on the server, never sent to the browser).
# Required in production — without it, broker login is disabled (dev default: 2468).
BROKER_PIN=
# Optional: separate secret for signing the 8-hour session cookie.
# BROKER_AUTH_SECRET=

# Demo Mode shows the CRM button, lead scores and broker demo panels to everyone in that browser.
# Turn it on per-visit with ?demo=true (off again with ?demo=false).
# NEXT_PUBLIC_DEMO_MODE=true          # start every visit in Demo Mode (sales-demo deployments)
# NEXT_PUBLIC_ALLOW_DEMO_MODE=false   # set on a client's live site to disable Demo Mode entirely
# NEXT_PUBLIC_SHOW_CRM_BUTTON=false   # hide the "Live Broker CRM" navbar button (e.g. on a client's live site)
